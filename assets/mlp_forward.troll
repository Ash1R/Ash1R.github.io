# Two-layer MLP forward pass, compiled through LLVM

fn dot(w, x, row, n) {
    let s = 0;
    let j = 0;
    while (j < n) {
        s = s + w[row * n + j] * x[j];
        j = j + 1;
    }
    return s;
}

fn relu(v) {
    if (v > 0) {
        return v;
    }
    return 0;
}

fn dense(w, b, x, out, rows, n, act) {
    let i = 0;
    while (i < rows) {
        let z = dot(w, x, i, n) + b[i];
        if (act > 0) {
            z = relu(z);
        }
        out[i] = z;
        i = i + 1;
    }
    return out;
}

fn argmax(v, n) {
    let best = 0;
    let i = 1;
    while (i < n) {
        if (v[i] > v[best]) {
            best = i;
        }
        i = i + 1;
    }
    return best;
}

let x  = [0.5, 0.2, 0.9];
let w1 = [0.8, 0.1, 0.4,   0.3, 0.9, 0.2,   0.5, 0.5, 0.5,   0.1, 0.7, 0.6];
let b1 = [0.1, 0.0, 0.2, 0.1];
let w2 = [0.6, 0.2, 0.9, 0.1,   0.3, 0.8, 0.4, 0.7];
let b2 = [0.05, 0.1];

let h = [0, 0, 0, 0];
let y = [0, 0];
dense(w1, b1, x, h, 4, 3, 1);
dense(w2, b2, h, y, 2, 4, 0);

print(h);
print(y);
print(argmax(y, 2));
